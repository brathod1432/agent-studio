# Normalize line endings so the repo behaves the same on Windows, macOS, Linux.
# Text files are stored with LF in the repo; Git converts on checkout as needed.
* text=auto eol=lf

# Explicitly treat these as text.
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Do not normalize binaries.
*.png  binary
*.jpg  binary
*.ico  binary
