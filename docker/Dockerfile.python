# Python 3.12 runtime + tool host. Standard-library only (no pip install of
# runtime dependencies).
#
# Build:  docker build -f docker/Dockerfile.python -t agent-studio-python .
# Run:    docker run --rm -it --env-file .env.local agent-studio-python doctor
#   tools: docker run --rm agent-studio-python tools list
FROM python:3.12-slim

WORKDIR /app

# The package + the shared config and prompt templates it reads at runtime.
COPY pyproject.toml ./
COPY config ./config
COPY src/py ./src/py
COPY src/engine/prompts/defaults ./src/engine/prompts/defaults

ENV PYTHONPATH=/app/src/py \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Non-root user.
RUN useradd --create-home --uid 10001 appuser
USER appuser

# Default to the CLI; override with a subcommand (doctor/ask/chat/tools/config).
ENTRYPOINT ["python", "-m", "agent_studio"]
CMD ["status"]
