# Agent Studio — environment template.
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is git-ignored and MUST NEVER be committed.
#
# Secrets are referenced from settings by name (e.g. "env:NVIDIA_API_KEY"),
# never stored in source or settings files.

# NVIDIA (default development provider)
NVIDIA_API_KEY=

# Optional: other providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
